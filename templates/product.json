{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "benefit_note": {
          "type": "text",
          "settings": {
            "text": "Designed to support organization, visibility, and calmer everyday routines.",
            "text_style": "subtitle"
          }
        },
        "shipping_note": {
          "type": "text",
          "settings": {
            "text": "Shipping and returns placeholder: replace with your final store policy before launch.",
            "text_style": "body"
          }
        },
        "details": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Details",
            "icon": "clipboard",
            "content": "Materials, dimensions, and care details will appear here. Replace this placeholder with product-specific information.",
            "page": ""
          }
        },
        "how_to_use": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How to use it",
            "icon": "check_mark",
            "content": "Place it where you already work or reset. Use it to make the next task, tool, or routine step easier to see.",
            "page": ""
          }
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping",
            "icon": "truck",
            "content": "Shipping information placeholder. Add processing times, shipping regions, and delivery estimates before launch.",
            "page": ""
          }
        },
        "returns": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Returns",
            "icon": "return",
            "content": "Returns information placeholder. Add your return window, item condition requirements, and support email before launch.",
            "page": ""
          }
        },
        "reviews_placeholder": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<section class=\"product__focus-reviews\" aria-labelledby=\"focus-reviews-heading\"><h2 id=\"focus-reviews-heading\" class=\"h4\">Customer reviews</h2><p>Reviews placeholder \u2014 connect your preferred reviews solution or add verified reviews after launch. No reviews have been added yet.</p></section>"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "benefit_note",
        "description",
        "shipping_note",
        "details",
        "how_to_use",
        "shipping",
        "returns",
        "reviews_placeholder",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 32,
        "padding_bottom": 24
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "More tools for your system",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-2",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
